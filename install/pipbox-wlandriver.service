[Unit]
Description=IRL4YOU BOX WLAN-Treiber für USB-Sticks mit AIC8800D80 (holt und baut den Treiber bei Bedarf)
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/pipbox/pipbox-wlandriver.py auto
TimeoutStartSec=25min
Nice=10
# Root-Rechte nur für diese eine Aufgabe: Der Dienst nimmt keine Eingaben an (feste Aufrufe "auto" und "uninstall"), darf nur Kernelmodule laden und
# Kernelmeldungen lesen, schreibt nur in die unten genannten Ordner, lädt nur den festen, per Prüfsumme gesicherten Treiberstand aus dem Netz und kann
# keine neuen Rechte erlangen.
CapabilityBoundingSet=CAP_SYS_MODULE CAP_SYSLOG CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/lib/modules /lib/firmware /etc/modprobe.d /run
StateDirectory=pipbox-wlandriver
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectClock=yes
# ProtectClock sperrt sonst alle Geräteknoten, auch die des USB-Sticks (usb_modeswitch)
DeviceAllow=char-usb_device rw
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
