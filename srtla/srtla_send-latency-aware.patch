+static void update_srtt(conn_t *c, double sample_ms) {
+  uint64_t now_ms;
+  if (sample_ms < 0 || sample_ms > 5000 || get_ms(&now_ms) != 0) return;
+  if (c->srtt_at_ms == 0 || (now_ms - c->srtt_at_ms) > LAT_FRESH_MS) {
+    c->srtt_ms = sample_ms;
+    c->rttvar_ms = 0;
+    c->peak_ms = sample_ms;
+  } else {
+    double e = sample_ms - c->srtt_ms;
+    if (e < 0) e = -e;
+    c->rttvar_ms = c->rttvar_ms * 0.75 + e * 0.25;
+    c->srtt_ms = c->srtt_ms * 0.875 + sample_ms * 0.125;
+    /* Spitze: klingt in etwa 15 s auf null ab, jede hoehere Probe setzt sie neu */
+    double dt = (double)(now_ms - c->peak_at_ms) / 1000.0;
+    double f = 1.0 - dt / 15.0;
+    if (f < 0) f = 0;
+    c->peak_ms *= f;
+    if (sample_ms > c->peak_ms) c->peak_ms = sample_ms;
+  }
+  c->peak_at_ms = now_ms;
+  c->srtt_at_ms = now_ms;
+}
+
+/* Guete eines Wegs (kleiner ist besser): Mittelwert plus Streuung, mindestens die halbe jüngste Spitze */
+static double link_metric(conn_t *c) {
+  double m = c->srtt_ms + 4.0 * c->rttvar_ms;
+  double pk = 0.5 * c->peak_ms;
+  return pk > m ? pk : m;
+}
+
+static int srtt_fresh(conn_t *c, uint64_t now_ms) {
+  return c->srtt_at_ms != 0 && (now_ms - c->srtt_at_ms) <= LAT_FRESH_MS;
+}
+
+/* Ist dieser Weg gegenueber dem besten (kleinste Guete) gut genug? Mit Traegheit: ein ausgeschlossener Weg kommt
+   erst zurueck, wenn er deutlich besser als die Ausschlussgrenze ist. */
+static int link_eligible(conn_t *c, double best_metric, uint64_t now_ms) {
+  if (!lat_pref || best_metric < 0) return 1;                /* keine Messung irgendwo: wie das Original */
+  if (!srtt_fresh(c, now_ms)) { c->elig = 0; return 0; }     /* neuer Weg: erst messen (Keepalive), dann nutzen */
+  double margin = lat_margin_ms;
+  if (best_metric * 0.5 > margin) margin = best_metric * 0.5;
+  double m = link_metric(c);
+  if (c->elig) {
+    if (m > best_metric + margin) c->elig = 0;
+  } else {
+    if (m <= best_metric + margin * 0.5) c->elig = 1;
+  }
+  return c->elig;
+}
