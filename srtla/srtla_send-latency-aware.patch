+/* Ein Weg, dessen Laufzeit mehr als LAT_MARGIN_MS (mindestens) ueber der des besten liegt, bekommt keine Pakete,
+   solange ein schnellerer Weg bereitsteht. Ein einziges verspaetetes Paket auf einem langsamen Weg haelt sonst die
+   kumulative SRT-Bestaetigung fuer ALLE Pakete auf und der Encoder senkt die Bitrate (Sendepuffer-Regler). */
+static int lat_pref = 1;
+static int lat_margin_ms = 20;
+#define LAT_FRESH_MS 5000
+
 char *source_ip_file = NULL;
 
